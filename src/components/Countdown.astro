---
import { event } from "../data/event";
---
<div class="countdown" id="countdown" role="timer" aria-label={`Time until ${event.title} starts`} data-start={event.start} data-end={event.end} hidden>
  <p class="cd-label">The first drop in</p>
  <div class="cd-units">
    <div class="cd-unit"><span class="cd-num" data-u="d">00</span><span class="cd-name">Days</span></div>
    <div class="cd-unit"><span class="cd-num" data-u="h">00</span><span class="cd-name">Hours</span></div>
    <div class="cd-unit"><span class="cd-num" data-u="m">00</span><span class="cd-name">Mins</span></div>
    <div class="cd-unit"><span class="cd-num" data-u="s">00</span><span class="cd-name">Secs</span></div>
  </div>
</div>

<script>
  /* Countdown to the start time in src/data/event.ts; shows "happening now" until the end, then hides */
  const cd = document.getElementById("countdown");
  if (cd) {
    const start = Date.parse(cd.dataset.start ?? ""), end = Date.parse(cd.dataset.end ?? "");
    const nums: Record<string, HTMLElement> = {};
    cd.querySelectorAll<HTMLElement>("[data-u]").forEach((el) => (nums[el.dataset.u!] = el));
    const pad = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      const now = Date.now();
      if (now >= end) { cd.hidden = true; clearInterval(timer); return; }
      if (now >= start) { cd.classList.add("live"); cd.querySelector(".cd-label")!.textContent = "The drop is happening now"; cd.hidden = false; return; }
      let s = Math.floor((start - now) / 1000);
      const d = Math.floor(s / 86400); s -= d * 86400;
      const h = Math.floor(s / 3600); s -= h * 3600;
      const m = Math.floor(s / 60); s -= m * 60;
      nums.d.textContent = pad(d); nums.h.textContent = pad(h); nums.m.textContent = pad(m); nums.s.textContent = pad(s);
      cd.hidden = false;
    };
    const timer = setInterval(tick, 1000);
    tick();
  }
</script>

<style>
/* On laptops it heads the landing text (order:-1, above the eyebrow);
   on phones it floats over the lower photo (see the 720px rules) */
.countdown{order:-1;display:grid;gap:12px;justify-self:start;margin-bottom:clamp(12px,2.5vw,28px)}
.countdown[hidden]{display:none}
.cd-label{margin:0;font-family:var(--font-mono);font-size:clamp(14px,1.3vw,16px);font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--crema)}
.cd-units{display:flex;align-items:flex-start}
.cd-unit{display:grid;justify-items:center;gap:6px;min-width:clamp(60px,6.5vw,92px);padding:0 clamp(12px,1.8vw,22px);border-left:1px solid var(--line)}
.cd-unit:first-child{padding-left:0;border-left:0;justify-items:start}
.cd-num{font-family:var(--font-dj);font-weight:800;font-size:clamp(44px,5.4vw,72px);line-height:.9;color:var(--fg);font-variant-numeric:tabular-nums}
.cd-name{font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(241,230,218,.42)}
.countdown.live .cd-units{display:none}
@media (max-width:720px){
  /* Phones: the countdown floats over the lower photo (her waist, above the deck) on a soft espresso wash */
  .countdown{position:absolute;left:0;bottom:calc(100% + 34px);z-index:2;margin:0;isolation:isolate}
  .countdown::before{content:"";position:absolute;inset:-28px -40px -24px -24px;z-index:-1;pointer-events:none;
    background:radial-gradient(closest-side,rgba(19,13,10,.62) 0%,rgba(19,13,10,.45) 50%,rgba(19,13,10,.16) 80%,rgba(19,13,10,0) 100%)}
  .cd-num{text-shadow:0 2px 12px rgba(19,13,10,.6)}
}
</style>
