---
import { event } from "../data/event";
---
<section aria-labelledby="how-h">
  <div class="two">
    <div class="sec-head">
      <p class="eyebrow">Guest list</p>
      <h2 class="small" id="how-h">How to get a spot</h2>
    </div>
    <ol class="steps">
      <li><div><h3>Message us on WhatsApp</h3><p>Tap the button on this page and send us a hello. Tell us your name and your Instagram handle.</p></div></li>
      <li><div><h3>Have a quick chat with us</h3><p>We’re keeping the night small and friendly, so we like to say hi to everyone before confirming.</p></div></li>
      <li><div><h3>Pay ₹{event.entryPrice} to confirm</h3><p>Once we confirm, we’ll send you a payment link. Your spot is held as soon as payment is received.</p></div></li>
      <li><div><h3>You’re on the guest list</h3><p>Bring your best dancing shoes. We’ll have your coffee ready.</p></div></li>
    </ol>
  </div>
</section>

<style>
/* Steps: a real sequence, so numbered */
.steps{margin:0;padding:0;list-style:none;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:56px minmax(0,1fr);gap:14px;padding:20px 0;border-top:1px solid var(--line)}
.steps li::before{content:counter(s);font-family:var(--font-display);font-weight:900;font-size:40px;line-height:.9;color:var(--crema)}
.steps h3{margin:0;font-size:18px;font-weight:600}
.steps p{margin:4px 0 0;color:var(--muted);max-width:56ch}
@media (max-width:560px){.steps li{grid-template-columns:44px minmax(0,1fr)}}
</style>
