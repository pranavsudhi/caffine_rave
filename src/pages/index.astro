---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TheNight from "../components/TheNight.astro";
import HowToBook from "../components/HowToBook.astro";
import MadAlice from "../components/MadAlice.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { event } from "../data/event";
---
<Base title={event.title}>
  <Header />
  <main class="wrap">
    <Hero />
    <TheNight />
    <HowToBook />
    <MadAlice />
    <Faq />
    <Closing />
    <Footer />
  </main>
</Base>
